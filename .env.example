# ── Database (Neon Postgres) ──────────────────────────────
# Pooled connection (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct connection (no "-pooler") — used only by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ── Session ───────────────────────────────────────────────
SESSION_SECRET="generate-with: openssl rand -hex 32"

# ── Site ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://cartridge-club.com"
NEXT_PUBLIC_SITE_NAME="Cartridge Club"

# ── Company / legal ──────────────────────────────────────
COMPANY_NAME="COMPANY NAME"
COMPANY_NUMBER="[REG_NUMBER]"
COMPANY_ADDRESS="[COMPANY ADDRESS]"
COMPANY_EMAIL="youremail@example.com"
COMPANY_PHONE="[COMPANY PHONE]"

# ── Kinguin ESA eCommerce API ────────────────────────────
KINGUIN_API_URL="https://gateway.kinguin.net/esa/api"
KINGUIN_API_KEY=""
KINGUIN_STORE_ID=""

# ── Kinguin Dev Portal OAuth ─────────────────────────────
KINGUIN_OAUTH_URL="https://id.kinguin.net/auth/token"
KINGUIN_CLIENT_ID=""
KINGUIN_CLIENT_SECRET=""

# ── SMTP ─────────────────────────────────────────────────
SMTP_HOST="mail.spacemail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="youremail@example.com"
SMTP_PASS=""
SMTP_FROM="Cartridge Club <youremail@example.com>"

# ── Back office ──────────────────────────────────────────
# Comma-separated list of emails allowed into /admin.
ADMIN_EMAILS="you@example.com"

# ── PayNT / OPPWA Copy & Pay ─────────────────────────────
# Test endpoint: https://eu-test.oppwa.com | Production: https://eu-prod.oppwa.com
PAYNT_BASE_URL="https://eu-test.oppwa.com"
# Channel Entity ID (Channel: PayNT*cartridge-club.com3DS)
PAYNT_ENTITY_ID="8ac9a4c9a0ce496501a10b62873b1817"
# User API Bearer Token provided by PayNT / SetoPay for server-to-server calls
PAYNT_BEARER_TOKEN=""
# Webhook notification secret (if configured)
PAYNT_WEBHOOK_SECRET=""

